# Copy to .env and fill in real values. .env is gitignored.

# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgresql+psycopg2://cia:cia_dev_password@localhost:5432/cia
# asyncpg variant, used by async SQLAlchemy engines
DATABASE_URL_ASYNC=postgresql+asyncpg://cia:cia_dev_password@localhost:5432/cia

OPENAI_API_KEY=

# Phase 4 RBAC - JWT signing. Dev-only default in config.py works locally;
# generate a real one before any shared/deployed environment: `openssl rand -hex 32`
JWT_SECRET_KEY=

# Phase 6 async infra - Celery broker/backend + progress pub/sub (matches
# docker-compose.yml's redis service default)
REDIS_URL=redis://localhost:6379/0
